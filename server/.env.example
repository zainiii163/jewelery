APP_NAME="JewelleryShop API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack

# SQLite (recommended for a single-server deployment)
DB_CONNECTION=sqlite
DB_DATABASE=../database/database.sqlite

# MySQL alternative (uncomment and comment the SQLite lines above)
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=jewellery_shop
# DB_USERNAME=root
# DB_PASSWORD=

SANCTUM_STATEFUL_DOMAINS=localhost:8000

CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file